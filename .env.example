# Copy to .env (ignored by Git) and set your own local values.
# The password goes into database URLs: keep it URL-safe (letters, digits, - _ .).
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulsewatch

# Only for running the API, the worker or the tests from the host (uv run).
# docker compose builds its own URL pointing at the db service.
DATABASE_URL=postgresql+psycopg://pulsewatch:change-me@localhost:5432/pulsewatch

# Optional worker settings (defaults shown).
# PROBE_INTERVAL_SECONDS=60
# PROBE_TIMEOUT_SECONDS=10
# PROBE_CONCURRENCY=20
